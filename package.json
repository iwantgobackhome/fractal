{
  "name": "fractal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "apps/desktop/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @fractal/shared && npm run build -w @fractal/ui && npm run build -w @fractal/hub",
    "test": "npm run test -w @fractal/shared && npm run test -w @fractal/hub && npm run test -w @fractal/ui",
    "typecheck": "npm run typecheck -w @fractal/shared && npm run typecheck -w @fractal/hub && npm run typecheck -w @fractal/ui",
    "hub": "tsx packages/hub/src/main.ts",
    "dev": "node scripts/dev.mjs",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis",
    "e2e": "tsx scripts/e2e.ts",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**\" \"apps/desktop/**/*.{js,cjs,ts}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json}\" \"scripts/**\" \"apps/desktop/**/*.{js,cjs,ts}\"",
    "tokens": "node scripts/gen-tokens.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "app.fractal.desktop",
    "productName": "Fractal",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "apps/desktop/main.cjs",
      "apps/desktop/preload.cjs",
      "apps/desktop/dist/**",
      "packages/ui/dist/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  }
}
